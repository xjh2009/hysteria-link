<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Hysteria2Link.Smoke</AssemblyName>
    <PclSdkRoot Condition="'$(PclSdkRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\sdk\2026.07.2\x64</PclSdkRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Hysteria2Link.Plugin\Hysteria2Link.Plugin.csproj" />
    <Reference Include="PCL.Core">
      <HintPath>$(PclSdkRoot)\PCL.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Plain Craft Launcher 2">
      <HintPath>$(PclSdkRoot)\Plain Craft Launcher 2.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
